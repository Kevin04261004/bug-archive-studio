  "CS0724": {
    "filename": "Uploader.cs",
    "message": "A throw statement with no arguments is not allowed in a nested finally clause",
    "focus_line": 14,
    "before": [
      "using System;",
      "using UnityEngine;",
      "",
      "public class Uploader : MonoBehaviour",
      "{",
      "    void Send()",
      "    {",
      "        try { Debug.Log(\"Sending\"); }",
      "        catch",
      "        {",
      "            try { Debug.Log(\"Retry\"); }",
      "            finally",
      "            {",
      "                throw;",
      "            }",
      "        }",
      "    }",
      "}"
    ],
    "after": [
